msgstr ""

#. Description of the plugin
#: cf-chunked-upload.php
msgid "Splits large files client-side and reassembles them server-side, bypassing PHP upload_max_filesize / post_max_size limits. Two surfaces: Media Library and a standalone large-file importer. Integrity-verified with per-chunk and whole-file SHA-256."
msgstr ""

