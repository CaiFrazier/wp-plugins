<?xml version="1.0"?>
<ruleset name="CF QR Redirect">
	<description>Coding standards for CF QR Redirect.</description>

	<rule ref="../phpcs.shared.xml"/>

	<file>cf-qr-redirect.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cf-qr-redirect"/>
			</property>
		</properties>
	</rule>

	<!--
		The shared ruleset deliberately does not require boilerplate docblocks on
		every function or property. These child sniffs otherwise still require
		@param/@var tags whenever a concise explanatory docblock is present,
		which contradicts that documented repository policy.
	-->
	<rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment.MissingVar">
		<severity>0</severity>
	</rule>
</ruleset>
