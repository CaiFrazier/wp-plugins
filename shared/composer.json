{
    "name": "caifrazier/wp-plugins-shared",
    "description": "Shared library for Cai Frazier WordPress plugins (logger, schema utilities).",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "version": "1.1.0",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
