<?xml version="1.0"?>
<ruleset name="CF Content Calendar">
	<description>Coding standards for CF Content Calendar.</description>

	<rule ref="../phpcs.shared.xml"/>

	<file>cf-content-calendar.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cf-content-calendar"/>
			</property>
		</properties>
	</rule>
</ruleset>
