<?xml version="1.0"?>
<ruleset name="CF WP Plugins — Shared Base">
	<description>Shared PHPCS base ruleset for all CF WordPress plugins.</description>

	<!--
		Per-plugin phpcs.xml.dist files extend this base via:

			<rule ref="../phpcs.shared.xml"/>

		Each plugin adds its own <file> targets, <exclude-pattern>s, and the
		WordPress.WP.I18n text_domain property pinning the plugin's text domain.
	-->

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.2"/>
	<config name="testVersion" value="8.1-"/>

	<!--
		Errors block CI; warnings inform. WPCS emits a long tail of low-priority
		warnings (deliberate file_get_contents on local paths, interface-required
		unused parameters, etc.) that are useful to see but should not fail the
		gate. This is the conventional "errors are the wall, warnings are the
		radar" policy. Real problems are reported as errors.
	-->
	<config name="ignore_warnings_on_exit" value="1"/>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<rule ref="WordPress">
		<!-- PSR-4 file naming, not WP file naming. -->
		<exclude name="WordPress.Files.FileName"/>
		<!--
			Short array syntax ([]) is the deliberate, consistent style across
			every plugin in this repo. The WordPress standard mandates long
			array() syntax; that single sniff would otherwise produce hundreds
			of purely-cosmetic "errors" against the established codebase.
		-->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<!--
			Mandatory-docblock sniffs. The stock WordPress standard requires a
			doc comment on every file, class, member, and function. This repo's
			house style is deliberately minimal-comment: comment
			only the non-obvious "why". Enforcing boilerplate docblocks on every
			trivial getter contradicts that and none of the existing plugins
			satisfy it. Real WHY-comments are still written where they matter.
		-->
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionCommentThrowTag.Missing"/>
		<!--
			Same minimal-comment rationale, extended to the docblock- and
			inline-comment *formatting* sniffs WPCS 3.4 enforces once any comment
			is present: mandatory @param tags/comments, @var tags, capitalized
			short descriptions, and full-stop-terminated inline comments. The
			house style writes prose "why" comments, not typed API boilerplate;
			enforcing tag completeness here just pressures authors to delete real
			explanatory comments to satisfy the linter. Missing-argument bugs are
			caught by the type system and tests, not @param tags.
		-->
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
		<exclude name="Squiz.Commenting.FunctionComment.WrongStyle"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamType"/>
		<exclude name="Squiz.Commenting.VariableComment.MissingVar"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="Generic.Commenting.DocComment.LongNotCapital"/>
		<exclude name="Generic.Commenting.DocComment.ShortNotCapital"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.InlineComment.WrongStyle"/>
		<!--
			Yoda conditions and short-ternary: WPCS style mandates the codebase
			deliberately and consistently does not follow (same class of choice
			as the short-array exclusion above). The code relies on strict-typing
			and tests, not assignment-in-condition guarding.
		-->
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<!--
			PHPCSExtra 3.x flags parameters named after reserved-ish words
			($default, $class, $match, …). Renaming public/overriding signatures
			across the codebase to satisfy this new sniff is churn with no
			readability or correctness gain.
		-->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
		<!--
			Silenced errors: the media plugins deliberately use @ on filesystem
			and image primitives (unlink, filesize, getimagesize, mkdir) where a
			race or a missing file is expected and handled by the following
			return-value check. WordPress core itself does this. The alternative
			(WP_Filesystem everywhere) is disproportionate for local variant I/O.
		-->
		<exclude name="WordPress.PHP.NoSilencedErrors"/>
		<!--
			Empty catch blocks: the media plugins deliberately swallow exceptions
			from best-effort operations (Imagick resource cleanup, optional
			encoder resource limits, cache-layer detection) where a failure is
			expected and the correct behavior is to carry on. Each such catch
			carries a WHY comment. Accidental swallowing is caught in review.
		-->
		<exclude name="Generic.CodeAnalysis.EmptyStatement.DetectedCatch"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
